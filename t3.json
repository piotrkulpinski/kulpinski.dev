{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "public/favicon.ico",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "for f in .env .env.local; do [ -f \"$T3CODE_PROJECT_ROOT/$f\" ] && cp \"$T3CODE_PROJECT_ROOT/$f\" \"$f\"; done; bun install",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Dev",
      "command": "bun run dev",
      "icon": "play",
      "previewUrl": "http://localhost:4322",
      "autoOpenPreview": true
    },
    {
      "name": "Lint",
      "command": "bun run lint",
      "icon": "lint"
    },
    {
      "name": "Format",
      "command": "bun run format",
      "icon": "configure"
    }
  ]
}
