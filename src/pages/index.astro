---
import { Image } from "astro:assets"
import { getCollection } from "astro:content"
import avatar from "~/assets/piotr-kulpinski-avatar.svg"
import Section from "~/components/global/Section.astro"
import TextLink from "~/components/global/TextLink.astro"
import PostList from "~/components/PostList.astro"
import ProjectList from "~/components/ProjectList.astro"
import BaseLayout from "~/layouts/BaseLayout.astro"

const allPosts = await getCollection("posts", ({ data }) => !data.isDraft)
const allProjects = await getCollection("projects")

const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5)

const projects = allProjects.sort(
  (a, b) => b.data.year - a.data.year || (b.data.month ?? 0) - (a.data.month ?? 0),
)
---

<BaseLayout>
  <section
    class="reveal grid gap-x-8 gap-y-6 sm:grid-cols-[8rem_minmax(0,1fr)]"
    style="--i: 0"
  >
    <Image
      src={avatar}
      alt="Illustrated portrait of Piotr Kulpinski"
      width={256}
      height={256}
      loading="eager"
      class="size-28 sm:size-32"
    />

    <div class="flex flex-col gap-4">
      <p class="font-medium text-balance">
        <dither-mark class="-mx-1 px-1 py-px">I build software products and run them end to end.</dither-mark>
      </p>

      <div class="space-y-4 text-dim text-pretty">
        <p>
          I've been writing software for over 15 years, first in agencies and product teams.
          Now I work on my own from Kraków, mostly on directories and SaaS tools.
        </p>
        <p>
          I like simple interfaces and short feedback loops. AI agents write much of my code
          now, so one person can run several products at once. I build in public and
          <TextLink href="/posts">write about what I learn</TextLink>.
        </p>
      </div>
    </div>
  </section>

  <Section label="Now" index={1}>
    <div class="space-y-4 text-dim text-pretty">
      <p>
        Most of my time goes into
        <TextLink href="https://highseat.com?utm_source=kulpinski.dev&utm_medium=referral">Highseat</TextLink>,
        cookieless web analytics that ties revenue to the source that brought it.
      </p>
      <p>
        I also run
        <TextLink href="https://openalternative.co">OpenAlternative</TextLink>,
        a directory of open source alternatives to proprietary software, and
        <TextLink href="https://dirstarter.com">Dirstarter</TextLink>,
        the Next.js boilerplate behind a growing number of indie directories.
      </p>
    </div>
  </Section>

  <Section label="Products" index={2}>
    <ProjectList projects={projects} />
  </Section>

  <Section label="Writing" index={3}>
    <PostList posts={posts} />

    <a
      href="/posts"
      class="mt-3 inline-flex font-mono text-[11px] text-faint uppercase tracking-widest hover:text-ink"
    >
      All posts →
    </a>
  </Section>
</BaseLayout>
