---
import { getCollection } from "astro:content"
import ProfilePicture from "~/assets/piotrkulpinski.webp"
import Section from "~/components/global/Section.astro"
import TextLink from "~/components/global/TextLink.astro"
import PostList from "~/components/PostList.astro"
import ProjectList from "~/components/ProjectList.astro"
import BaseLayout from "~/layouts/BaseLayout.astro"

const allPosts = await getCollection("posts", ({ data }) => !data.isDraft)
const allProjects = await getCollection("projects")

const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5)

const projects = allProjects.sort(
  (a, b) => b.data.year - a.data.year || (b.data.month ?? 0) - (a.data.month ?? 0),
)
---

<BaseLayout>
  <section
    class="reveal grid gap-x-8 gap-y-6 sm:grid-cols-[8rem_minmax(0,1fr)]"
    style="--i: 0; --section: var(--color-pink); --section-soft: var(--color-pink-soft); --section-text: var(--color-pink-text)"
  >
    <dither-portrait class="size-28 sm:size-32">
      <img
        src={ProfilePicture.src}
        width={ProfilePicture.width}
        height={ProfilePicture.height}
        alt="Illustrated portrait of Piotr Kulpinski"
        class="size-full"
        decoding="async"
      />
    </dither-portrait>

    <div class="flex flex-col gap-4">
      <p class="font-medium text-balance">
        <dither-mark class="-mx-1 px-1 py-px">I build small software products and run them myself.</dither-mark>
      </p>

      <div class="space-y-4 text-dim text-pretty">
        <p>
          I've been writing software for 15+ years, first in agencies and product teams, and
          now on my own from Kraków. Most of what I make is directories, SaaS tools, and the
          boilerplate that powers both.
        </p>
        <p>
          I like simple interfaces and short feedback loops. AI agents write a lot of my code
          these days, so I ship more than one person probably should. I build in
          public, and most of what I learn ends up in my writing.
        </p>
      </div>
    </div>
  </section>

  <Section label="Now" accent="orange" index={1}>
    <div class="space-y-4 text-dim text-pretty">
      <p>
        Most of my time goes into
        <TextLink href="https://highseat.com?utm_source=kulpinski.dev&utm_medium=referral">Highseat</TextLink>,
        cookieless web analytics that ties revenue to the source that brought it.
      </p>
      <p>
        <TextLink href="https://openalternative.co">OpenAlternative</TextLink>
        and
        <TextLink href="https://dirstarter.com">Dirstarter</TextLink>
        keep running alongside it. One is the largest directory of open source software, the
        other is the Next.js boilerplate behind a growing number of indie directories.
      </p>
    </div>
  </Section>

  <Section label="Products" accent="teal" index={2}>
    <ProjectList projects={projects} />
  </Section>

  <Section label="Writing" accent="green" index={3}>
    <PostList posts={posts} />

    <a
      href="/posts"
      class="mt-3 inline-flex font-mono text-[11px] text-faint uppercase tracking-widest hover:text-ink"
    >
      All posts →
    </a>
  </Section>
</BaseLayout>
