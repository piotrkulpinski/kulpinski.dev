---
import Intro from "~/components/global/Intro.astro"
import Prose from "~/components/global/Prose.astro"
import BaseLayout from "~/layouts/BaseLayout.astro"
---

<BaseLayout>
  <Intro>
    <h1 slot="title">Page not found</h1>

    <Prose>
      <p>
        The page you are looking for does not exist.<br /><a href="/">Go back to the home page</a>.
      </p>
    </Prose>
  </Intro>

  <!--
    Reports a soft navigation into this page — the client router swaps documents,
    so there is no request whose status the tracker could read. A hard landing
    needs nothing here (the tracker reads the 404 off the navigation entry) and
    it de-duplicates the two, so firing on both paths is safe.
    `once` matters: the document survives view transitions, so a listener left
    behind would report a 404 on every page the visitor opened afterwards.
  -->
  <script is:inline>
    document.addEventListener("astro:page-load", () => window.analytics?.track("404"), {
      once: true,
    })
  </script>
</BaseLayout>
