---
import Intro from "~/components/global/Intro.astro"
import Prose from "~/components/global/Prose.astro"
import BaseLayout from "~/layouts/BaseLayout.astro"
---

<BaseLayout>
  <Intro>
    <h1 slot="title">Page not found</h1>

    <Prose>
      <p>
        The page you are looking for does not exist.<br /><a href="/">Go back to the home page</a>.
      </p>
    </Prose>
  </Intro>

  <!--
    Reports a soft navigation into this page: the ClientRouter swaps documents, so there is no
    request whose status the tracker could read. A hard landing needs nothing here (the tracker
    reads the 404 off the navigation entry) and it de-duplicates the two, so firing on both paths
    is safe. A bundled script runs once per document, while the ClientRouter can bring a visitor
    here many times, so the listener stays for the document's life and checks that the page it
    loaded is this one. With `once` it would miss every later visit.
  -->
  <div hidden data-not-found></div>

  <script>
    import { track } from "highseat"

    document.addEventListener("astro:page-load", () => {
      if (document.querySelector("[data-not-found]")) track("404")
    })
  </script>
</BaseLayout>
