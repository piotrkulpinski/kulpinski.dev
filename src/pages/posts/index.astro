---
import { getCollection } from "astro:content"
import Section from "~/components/global/Section.astro"
import PostList from "~/components/PostList.astro"
import BaseLayout from "~/layouts/BaseLayout.astro"

const allPosts = await getCollection("posts", ({ data }) => !data.isDraft)
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())

const years = Map.groupBy(posts, post => post.data.pubDate.getFullYear())
---

<BaseLayout title="Writing">
  <Section label="Writing" heading="h1">
    <p class="text-dim text-pretty">
      Notes on software, SEO, open source, and shipping small things.
    </p>
  </Section>

  {
    [...years].map(([year, items], i) => (
      <Section label={String(year)} index={i + 1}>
        <PostList posts={items} dateStyle="monthDay" />
      </Section>
    ))
  }
</BaseLayout>
