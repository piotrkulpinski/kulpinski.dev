---
import { HIGHSEAT_PATH, HIGHSEAT_SITE } from "astro:env/client"
import { ClientRouter } from "astro:transitions"
import { SEO, type SEOProps } from "astro-seo"
import merge from "deepmerge"
import Footer from "~/components/global/Footer.astro"
import Navigation from "~/components/global/Navigation.astro"

import "~/styles.css"

type Props = SEOProps

const { title, description, ...seoProps } = Astro.props

const globalTitle = "Piotr Kulpinski's Blog"
const globalDescription =
  "I work as an independent software engineer and designer. I'm passionate about creating beautiful, accessible, and performant web. I write about things I learn and find interesting."
const metaUrl = Astro.request.url
const metaTitle = `${title ? `${title} - ` : ""}${globalTitle}`
const metaDescription = description || globalDescription

const baseSeo = {
  title: metaTitle,
  description: metaDescription,
  canonical: metaUrl,
  openGraph: {
    basic: {
      title: metaTitle,
      type: "website",
      image: new URL("/opengraph.png", Astro.request.url).toString(),
      url: metaUrl,
    },
  },
  twitter: {
    creator: "@piotrkulpinski",
    card: "summary_large_image",
  },
} satisfies SEOProps

const seo = merge(baseSeo, seoProps, {
  arrayMerge: (_, sourceArray) => sourceArray,
})
---

<html lang="en" style="font-size: 93.75%;">
  <head>
    <SEO {...seo} />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Piotr Kulpinski" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://rsms.me/" />

    <!-- Highseat. A real `defer` tag rather than inject(): the tracker starts before any page
      script, so its first pageview precedes every track() call, and the tag survives the
      ClientRouter's page swaps. -->
    <script is:inline defer src={HIGHSEAT_PATH} data-site={HIGHSEAT_SITE}></script>

    <!-- Applies the stored or system theme before first paint, and again after each client
      router swap, because the swap replaces the attributes on <html>. -->
    <script is:inline>
      ;(() => {
        const media = window.matchMedia("(prefers-color-scheme: dark)")

        function apply() {
          let stored = null
          try {
            stored = localStorage.getItem("theme")
          } catch {}
          const isDark = stored ? stored === "dark" : media.matches
          document.documentElement.dataset.theme = isDark ? "dark" : "light"
          document.documentElement.classList.add("js")
        }

        apply()

        if (window.__themeBound) {
          return
        }

        window.__themeBound = true
        document.addEventListener("astro:after-swap", apply)
        media.addEventListener("change", apply)
      })()
    </script>

    <ClientRouter />
  </head>

  <body class="bg-background text-ink">
    <div class="mx-auto flex min-h-screen w-full max-w-[46rem] flex-col px-5 pt-12 pb-6 sm:pt-16">
      <Navigation />

      <main class="mt-14 flex flex-col gap-16 sm:mt-16">
        <slot />
      </main>

      <Footer />
    </div>

    <script>
      import "~/elements/dither-mark"
      import "~/elements/dither-field"
      import "~/elements/theme-clock"
    </script>
  </body>
</html>
