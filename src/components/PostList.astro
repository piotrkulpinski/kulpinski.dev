---
import type { CollectionEntry } from "astro:content"
import Row from "~/components/global/Row.astro"
import { formatDate, formatMonthDay } from "~/utils"

interface Props {
  posts: CollectionEntry<"posts">[]
  dateStyle?: "full" | "monthDay"
}

const { posts, dateStyle = "full" } = Astro.props

function formatAside(date: Date) {
  return dateStyle === "monthDay" ? formatMonthDay(date) : formatDate(date)
}
---

{
  posts.length ? (
    <ul class="flex flex-col">
      {posts.map(({ data, id }) => (
        <Row href={`/posts/${id}`} title={data.shortTitle ?? data.title} aside={formatAside(data.pubDate)} />
      ))}
    </ul>
  ) : (
    <p class="text-dim">No posts found.</p>
  )
}
