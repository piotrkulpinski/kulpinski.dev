---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  light: ImageMetadata
  dark: ImageMetadata
  alt: string
}

const { light, dark, alt } = Astro.props
---

<Image src={light} alt={alt} class="dark:hidden" />
<Image src={dark} alt={alt} class="hidden dark:block" />
