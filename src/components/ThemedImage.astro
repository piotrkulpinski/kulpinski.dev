---
import { getImage, Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  light: ImageMetadata
  dark: ImageMetadata
  alt: string
}

const { light, dark, alt } = Astro.props
const darkImage = await getImage({ src: dark })
---

<picture>
  <source media="(prefers-color-scheme: dark)" srcset={darkImage.src} />
  <Image src={light} alt={alt} />
</picture>
