---
import type { CollectionEntry } from "astro:content"
import Row from "~/components/global/Row.astro"

interface Props {
  projects: CollectionEntry<"projects">[]
}

const { projects } = Astro.props

const groups = [
  { category: "saas", label: "SaaS" },
  { category: "directory", label: "Directories" },
  { category: "tool", label: "Tools" },
] as const
---

<div class="flex flex-col gap-6">
  {
    groups.map(({ category, label }) => {
      const items = projects.filter(({ data }) => data.category === category)
      if (!items.length) return null

      return (
        <div>
          <h3 class="mb-1 font-mono text-[11px] text-faint uppercase tracking-widest">{label}</h3>

          <ul class="flex flex-col">
            {items.map(({ data }) => (
              <Row
                href={data.url ?? "#"}
                title={data.title}
                description={data.description}
                aside={String(data.year)}
                external
              />
            ))}
          </ul>
        </div>
      )
    })
  }
</div>
