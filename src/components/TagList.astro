---
import Row from "~/components/global/Row.astro"

type Props = {
  tags: { tag: string; count: number }[]
}

const { tags } = Astro.props
---

{
  tags.length ? (
    <ul class="flex flex-col">
      {tags.map(({ tag, count }) => (
        <Row href={`/tags/${tag}/`} title={`#${tag}`} aside={`${count} ${count === 1 ? "post" : "posts"}`} />
      ))}
    </ul>
  ) : (
    <p class="text-dim">No tags found.</p>
  )
}
