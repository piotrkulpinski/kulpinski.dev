---
import type { HTMLAttributes } from "astro/types"
import Arrow from "~/components/global/Arrow.astro"

type Props = HTMLAttributes<"a"> & {
  external?: boolean
}

const { external, class: className, ...props } = Astro.props
const isExternal = external ?? String(props.href ?? "").startsWith("http")
const linkProps = isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}

// The markup stays on one line: a line break inside the link renders as an underlined space.
---

<a class:list={[className, "text-link group/arrow"]} {...linkProps} {...props}><slot />{isExternal && <Arrow class="ml-1 !text-current" />}</a>
