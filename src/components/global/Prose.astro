---
import type { HTMLAttributes } from "astro/types"

type Props = HTMLAttributes<"div">

const { class: className, ...props } = Astro.props
---

<div
  class:list={[
    className,
    "prose w-full max-w-none text-pretty text-dim",
    "[--tw-prose-body:var(--dim)] [--tw-prose-headings:var(--ink)] [--tw-prose-bold:var(--ink)] [--tw-prose-links:var(--section-text,var(--ink))] [--tw-prose-quotes:var(--ink)] [--tw-prose-quote-borders:var(--line)] [--tw-prose-bullets:var(--faint)] [--tw-prose-counters:var(--faint)] [--tw-prose-hr:var(--line)] [--tw-prose-code:var(--ink)] [--tw-prose-captions:var(--faint)] [--tw-prose-th-borders:var(--line)] [--tw-prose-td-borders:var(--line)]",
    "first:prose-p:mt-0 last:prose-p:mb-0",
    "prose-a:font-medium prose-a:text-[var(--section-text,var(--ink))] prose-a:underline prose-a:decoration-transparent prose-a:decoration-[1.5px] prose-a:underline-offset-[3px] prose-a:transition-[text-decoration-color] prose-a:hover:decoration-current",
    "prose-strong:font-medium",
    "prose-ul:list-outside prose-ol:list-outside first:prose-ul:mt-0 last:prose-ul:mb-0 prose-ul:pl-5 prose-ol:pl-5",
    "prose-li:m-0",
    "prose-img:border prose-img:border-line",
    "prose-pre:border prose-pre:border-line prose-pre:!bg-ink/[0.03] prose-pre:text-[0.875rem] prose-pre:rounded-none",
    "prose-inline-code:before:hidden prose-inline-code:after:hidden prose-inline-code:bg-ink/[0.07] prose-inline-code:px-[0.33em] prose-inline-code:py-[0.166em] prose-inline-code:font-normal",
    "prose-headings:font-medium prose-headings:tracking-tight prose-h1:text-[1.6em] prose-h2:text-[1.3em] prose-h3:text-[1.1em]",
  ]}
  {...props}
>
  <slot />
</div>
