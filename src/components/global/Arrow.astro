---
interface Props {
  direction?: "out" | "left"
  class?: string
}

const { direction = "out", class: className } = Astro.props

// Each direction has its own path and its own nudge on hover.
const variants = {
  out: {
    path: "M2.5 7.5 7.5 2.5M3.5 2.5h4v4",
    class: "align-[0.05em] group-hover/arrow:translate-x-px group-hover/arrow:-translate-y-px",
  },
  left: {
    path: "M8.5 5h-7M4.5 2 1.5 5l3 3",
    class: "group-hover/arrow:-translate-x-px",
  },
}

const variant = variants[direction]
---

<svg
  aria-hidden="true"
  viewBox="0 0 10 10"
  class:list={[
    className,
    variant.class,
    "inline-block size-2.5 shrink-0 text-faint transition-[translate,color] duration-200 ease-out group-hover/arrow:text-(--accent)",
  ]}
>
  <path
    d={variant.path}
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
    stroke-linecap="square"
  />
</svg>
