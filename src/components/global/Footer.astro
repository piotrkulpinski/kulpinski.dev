---
import Arrow from "~/components/global/Arrow.astro"

const year = new Date().getFullYear()

const contacts = [
  { label: "Email", href: "mailto:piotr@kulpinski.pl" },
  { label: "X", href: "https://x.com/piotrkulpinski" },
  { label: "Bluesky", href: "https://bsky.app/profile/kulpinski.dev" },
  { label: "GitHub", href: "https://github.com/piotrkulpinski" },
]
---

<footer class="mt-auto pt-24">
  <dither-field class="min-h-44">
    <div class="relative flex min-h-44 flex-col items-start justify-end gap-1.5 p-3 sm:p-4">
      <h2 class="chip flex items-center gap-2.5 px-2 py-1 font-mono text-[11px] uppercase tracking-widest">
        <span aria-hidden="true" class="size-2 shrink-0 bg-(--accent)"></span>
        Contact
      </h2>

      <p class="chip px-2.5 py-1.5 text-lg font-medium">Say hello.</p>

      <ul class="flex flex-wrap gap-1.5 font-mono text-[12px] uppercase tracking-[0.08em]">
        {
          contacts.map(({ label, href }) => (
            <li>
              <a
                href={href}
                target={href.startsWith("http") ? "_blank" : undefined}
                rel="me noreferrer"
                class="chip group/arrow inline-flex items-center gap-1.5 px-2.5 py-1.5"
              >
                {label}
                <Arrow />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </dither-field>

  <div class="mt-4 flex flex-wrap justify-between gap-3 font-mono text-[11px] text-faint uppercase tracking-widest">
    <p>© {year} Piotr Kulpinski</p>
    <a href="/tags" class="hover:text-ink">Tags</a>
  </div>
</footer>
