---
import Arrow from "~/components/global/Arrow.astro"

type Props = {
  href: string
  title: string
  description?: string
  aside?: string
  external?: boolean
}

const { href, title, description, aside, external = false } = Astro.props
const linkProps = external ? { target: "_blank", rel: "noopener noreferrer" } : {}
---

<li>
  <a href={href} class="group/arrow block py-1.5 outline-offset-4" {...linkProps}>
    <span class="flex items-baseline gap-4">
      <span class="min-w-0 font-medium text-pretty group-hover/arrow:text-dim">
        {title}{external && <Arrow class="ml-1.5" />}
      </span>

      {
        aside && (
          <span class="ml-auto shrink-0 font-mono text-[11px] text-faint uppercase tracking-[0.08em] tabular-nums">
            {aside}
          </span>
        )
      }
    </span>

    {description && <span class="block text-dim">{description}</span>}
  </a>
</li>
